# Paths for OpenPI + LIBERO public runners
BAS_OPENPI_ROOT=/path/to/openpi
BAS_LIBERO_ROOT=/path/to/LIBERO
BAS_OPENPI_CHECKPOINT=/path/to/pi05_libero_checkpoint

# Paths for OpenVLA-OFT + LIBERO public runners
# BAS_OPENVLA_OFT_ROOT=/path/to/openvla-oft
# BAS_OPENVLA_OFT_CHECKPOINT=/path/to/openvla_oft_checkpoint
# BAS_OPENVLA_OFT_SITE_PACKAGES=/path/to/openvla-oft/site-packages
# BAS_LEROBOT_SITE_PACKAGES=/path/to/lerobot/site-packages
# BAS_LIBERO_DATASETS_ROOT=/path/to/LIBERO/datasets

# Optional overrides
# BAS_PYTHON_BIN=/path/to/python
# BAS_LIBERO_SITE_PACKAGES=/path/to/libero/site-packages
# LIBERO_CONFIG_PATH=/path/to/libero_config

# Optional grounded preserving backends
# BAS_GROUNDING_DINO_MODEL_ID=IDEA-Research/grounding-dino-tiny
# BAS_SAM2_MODEL_ID=facebook/sam2.1-hiera-large
# BAS_GROUNDED_DEVICE=auto
